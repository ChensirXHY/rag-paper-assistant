# ============================================================
# 环境变量模板
#
# 用法：复制本文件为 .env 并填入真实值
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
#
# ⚠️ .env 已在 .gitignore 中，不会也不应被提交到仓库。
#    提交前请用 `git status` 确认列表里看不到 .env。
# ============================================================

# ---------- 大模型 API（必填）----------
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 路径（选填，默认值已在 config.py 中给出）----------
# PAPERS_DIR=./papers
# CHROMA_DB_DIR=./chroma_db
# EMBEDDING_MODEL=./local_models/BAAI/bge-large-zh-v1.5

# ---------- 检索与切分参数（选填）----------
# 这些值直接决定检索质量。修改后请重跑 eval/run_eval.py 验证，
# 不要凭感觉调参 —— README 的消融表就是这些默认值的依据。
#
# CHUNK_SIZE=500        # 中文论文一个自然段约 300~600 字
# CHUNK_OVERLAP=50
#
# RETRIEVE_TOP_K=8      由消融实验确定：
#                       k=1→Recall 63.6% | k=4→72.7% | k=8→100% | k=12→100%
#                       设为 4 可把平均延迟从 18.2s 降到 11.3s，但命中率降到 72.7%
# FETCH_K=32            MMR 重排前的候选池，需显著大于 top_k
# MMR_LAMBDA=0.5        # 0=纯相似度，1=纯多样性

# ---------- 运行环境（选填）----------
# auto | cuda | cpu —— auto 会自动探测，无显卡环境无需改代码
# DEVICE=auto
# LOG_LEVEL=INFO
