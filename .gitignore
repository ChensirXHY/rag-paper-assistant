# ============================================================
# .gitignore —— RAG 文献问答项目
# 原则：凡是"能重新生成的"和"含密钥的"都不进仓库
# ============================================================

# ---------- 密钥（最高优先级；一旦泄露需立刻吊销并重写历史）----------
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.conda/

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.tmp_tests/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# ---------- IDE / 编辑器（个人配置，不应进公共仓库）----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本项目特有：可重新生成的产物 ----------
# 本地模型权重（1.3 GB，让使用者自行下载）
local_models/
# 用户自己的论文文献（版权 + 隐私，不进公共仓库）
papers/
# 向量数据库索引（可由 papers/ 重建）
chroma_db/
*.sqlite3
*.index

# ---------- 运行产物 ----------
logs/
*.log
eval/reports/

# ---------- 重构/部署备份目录（不入库）----------
_backup*/
